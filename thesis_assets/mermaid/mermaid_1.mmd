flowchart TD
    A["用户选择输入源"] --> B["后端接入摄像头或本地视频"]
    B --> C["YOLO 模型实时检测"]
    C --> D{"是否识别到跌倒"}
    D -- "否" --> E["前端持续展示检测结果"]
    E --> C
    D -- "是" --> F["触发报警提示"]
    F --> G["保存报警记录"]
    F --> H["保存关键帧与留证视频"]
    F --> I["按配置发送通知"]
    G --> J["管理员查看报警"]
    H --> J
    I --> K["写入通知日志"]
    J --> L["提交报警工单"]
    L --> M["更新报警状态"]
    L --> N["写入用户消息"]
    M --> O["进入统计分析与健康报告"]
